datasource db {
    provider = 'postgresql'
    url      = env("DATABASE_URL")
}

type StandardCUIDModel {
    id        String   @id @default(cuid())
    createdAt DateTime @db.Timestamptz() @default(now())
    updatedAt DateTime @db.Timestamptz() @updatedAt
}

model User with StandardCUIDModel {
    email String @unique
    notes Note[]
}

model Note with StandardCUIDModel {
    title      String
    content    String
    archivedAt DateTime @db.Timestamptz()
    tags       String[]

    user       User     @relation(fields: [userId], references: [id])
    userId     String
}